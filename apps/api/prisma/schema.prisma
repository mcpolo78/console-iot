generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
}

model Device {
  id        Int         @id @default(autoincrement())
  name      String
  type      String
  lat       Float
  lng       Float
  online    Boolean     @default(true)
  telemetry Telemetry[]
  alerts    Alert[]
}

model Telemetry {
  id          Int      @id @default(autoincrement())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId    Int
  temperature Float
  battery     Float
  at          DateTime @default(now())

  @@index([deviceId, at])
}

enum AlertType {
  TEMPERATURE
  BATTERY
}

model Alert {
  id        Int       @id @default(autoincrement())
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  Int
  type      AlertType
  value     Float
  threshold Float
  message   String
  at        DateTime  @default(now())

  @@index([at])
}
